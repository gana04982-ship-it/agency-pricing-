      "1080p export ready for Meta/Instagram",
    ],
    not_included: [
      "Voiceover",
      "Multiple concepts",
    ],
    cta: "Best for: Testing the waters",
  },
  {
    name: "BLAZE",
    tagline: "Most popular — full experience",
    price_inr: "₹12,999",
    price_usd: "$155",
    color: "#FF6B35",
    featured: true,
    features: [
      "3 AI Video Ads",
      "Up to 60 seconds each",
      "Professional voiceover",
      "Background music included",
      "Captions & text overlays",
      "24-hour delivery per video",
      "2 revision rounds per video",
      "1080p export ready for Meta/Instagram",
      "3 different concepts & styles",
    ],
    not_included: [],
    cta: "Best for: Brands ready to run ads",
  },
  {
    name: "EMPIRE",
    tagline: "For brands that mean business",
    price_inr: "₹24,999",
    price_usd: "$299",
    color: "#A78BFA",
    features: [
      "6 AI Video Ads",
      "Up to 60 seconds each",
      "Professional voiceover",
      "Background music included",
      "Captions & text overlays",
      "24-hour delivery per video",
      "3 revision rounds per video",
      "1080p export ready for Meta/Instagram",
      "6 unique concepts & styles",
      "1 month of content covered",
      "Priority support via WhatsApp",
    ],
    not_included: [],
    cta: "Best for: Scaling with consistency",
  },
];

export default function Packages() {
  const [currency, setCurrency] = useState("inr");

  return (
    <div style={{
      minHeight: "100vh",
      background: "#0A0A0F",
      fontFamily: "'Georgia', serif",
      color: "#E8E4DC",
      padding: "28px 16px",
    }}>
      {/* Header */}
      <div style={{ textAlign: "center", marginBottom: 32 }}>
        <div style={{
          display: "inline-block",
          background: "#FF6B3515",
          border: "1px solid #FF6B3540",
          borderRadius: 4,
          padding: "4px 14px",
          fontSize: 11,
          letterSpacing: 3,
          color: "#FF6B35",
          marginBottom: 12,
          textTransform: "uppercase",
          fontFamily: "monospace",
        }}>
          Lessy Agency
        </div>
        <h1 style={{
          fontSize: "clamp(26px, 6vw, 40px)",
          fontWeight: 400,
          margin: "0 0 8px",
          letterSpacing: -1,
        }}>
          AI Video Ad Packages
        </h1>
        <p style={{ color: "#666", fontSize: 13, margin: "0 0 20px", fontFamily: "monospace" }}>
          24hr delivery · Music · Captions · Voiceover
        </p>

        {/* Currency Toggle */}
        <div style={{
          display: "inline-flex",
          background: "#141418",
          border: "1px solid #222",
          borderRadius: 8,
          padding: 3,
          gap: 3,
        }}>
          {["inr", "usd"].map(c => (
            <button
              key={c}
              onClick={() => setCurrency(c)}
              style={{
                background: currency === c ? "#FF6B35" : "transparent",
                color: currency === c ? "#0A0A0F" : "#666",
                border: "none",
                borderRadius: 6,
                padding: "6px 18px",
                fontSize: 12,
                fontFamily: "monospace",
                letterSpacing: 1,
                cursor: "pointer",
                fontWeight: currency === c ? 700 : 400,
                transition: "all 0.2s",
              }}
            >
              {c.toUpperCase()}
            </button>
          ))}
        </div>
      </div>

      {/* Cards */}
      <div style={{ display: "flex", flexDirection: "column", gap: 16, maxWidth: 480, margin: "0 auto" }}>
        {packages.map((pkg) => (
          <div
            key={pkg.name}
            style={{
              background: pkg.featured ? `linear-gradient(135deg, ${pkg.color}12 0%, #111116 60%)` : "#111116",
              border: `1px solid ${pkg.featured ? pkg.color + "60" : "#1E1E25"}`,
              borderRadius: 14,
              overflow: "hidden",
              position: "relative",
            }}
          >
            {pkg.featured && (
              <div style={{
                background: pkg.color,
                color: "#0A0A0F",
                fontSize: 10,
                fontFamily: "monospace",
                letterSpacing: 2,
                fontWeight: 700,
                textAlign: "center",
                padding: "5px 0",
              }}>
                MOST POPULAR
              </div>
            )}

            <div style={{ padding: "20px 20px 24px" }}>
              {/* Package Name & Price */}
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 4 }}>
                <div>
                  <div style={{
                    color: pkg.color,
                    fontSize: 11,
                    fontFamily: "monospace",
                    letterSpacing: 3,
                    marginBottom: 4,
                  }}>
                    {pkg.name}
                  </div>
                  <div style={{ color: "#888", fontSize: 12 }}>{pkg.tagline}</div>
                </div>
                <div style={{ textAlign: "right" }}>
                  <div style={{
                    fontSize: 24,
                    fontWeight: 600,
                    color: pkg.color,
                    lineHeight: 1,
                  }}>
                    {currency === "inr" ? pkg.price_inr : pkg.price_usd}
                  </div>
                  <div style={{ color: "#444", fontSize: 10, fontFamily: "monospace", marginTop: 3 }}>
                    one-time
                  </div>
                </div>
              </div>

              {/* Divider */}
              <div style={{ height: 1, background: "#1E1E25", margin: "16px 0" }} />

              {/* Features */}
              <div style={{ display: "flex", flexDirection: "column", gap: 9 }}>
                {pkg.features.map((f, i) => (
                  <div key={i} style={{ display: "flex", gap: 10, alignItems: "flex-start" }}>
                    <div style={{
                      color: pkg.color,
                      fontSize: 14,
                      lineHeight: 1.4,
                      flexShrink: 0,
                    }}>✦</div>
                    <span style={{ fontSize: 13, color: "#C8C4BC", lineHeight: 1.5 }}>{f}</span>
                  </div>
                ))}
                {pkg.not_included.map((f, i) => (
                  <div key={i} style={{ display: "flex", gap: 10, alignItems: "flex-start" }}>
                    <div style={{ color: "#333", fontSize: 14, lineHeight: 1.4, flexShrink: 0 }}>✕</div>
                    <span style={{ fontSize: 13, color: "#444", lineHeight: 1.5 }}>{f}</span>
                  </div>
                ))}
              </div>

              {/* CTA Tag */}
              <div style={{
                marginTop: 16,
                background: `${pkg.color}15`,
                border: `1px solid ${pkg.color}30`,
                borderRadius: 6,
                padding: "8px 12px",
                fontSize: 12,
                color: pkg.color,
                fontFamily: "monospace",
                textAlign: "center",
                letterSpacing: 0.5,
              }}>
                {pkg.cta}
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Bottom note */}
      <div style={{
        textAlign: "center",
        marginTop: 28,
        padding: "0 20px",
      }}>
        <div style={{
          background: "#111116",
          border: "1px solid #1E1E25",
          borderRadius: 10,
          padding: "16px 20px",
          maxWidth: 480,
          margin: "0 auto",
        }}>
          <div style={{ fontSize: 12, color: "#666", lineHeight: 1.7, fontFamily: "monospace" }}>
            📦 100% custom to your brand vision<br />
            ⚡ 50% advance to confirm · 50% on delivery<br />
            🌍 International payments accepted<br />
            📩 DM to book · lessyversestudio@gmail.com
          </div>
        </div>
      </div>

      <div style={{
        textAlign: "center",
        marginTop: 20,
        fontSize: 11,
        color: "#222",
        fontFamily: "monospace",
        letterSpacing: 2,
      }}>
        LESSY AGENCY · AI-POWERED VIDEO ADS
      </div>
